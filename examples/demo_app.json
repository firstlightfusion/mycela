{
  "title": "Mycela Demo",
  "home_screen": "epics",
  "defaults": {
    "style": { "width": "100%", "height": "auto" }
  },
  "presets": {
    "level": {
      "data_type": "double",
      "metadata": {
        "display": { "limit_low": 0.0, "limit_high": 100.0, "description": "Tank T-101 level", "precision": 1, "units": "%" },
        "control": { "limit_low": 0.0, "limit_high": 100.0, "min_step": 0.5 },
        "alarm": { "low_alarm_limit": 10.0, "low_warning_limit": 20.0, "high_warning_limit": 80.0, "high_alarm_limit": 90.0, "low_alarm_severity": "MAJOR", "low_warning_severity": "MINOR", "high_warning_severity": "MINOR", "high_alarm_severity": "MAJOR", "hysteresis": 1 }
      }
    },
    "sensor-fault": {
      "type": "text_update",
      "label": "Invalid",
      "description": "Signal below range is treated as a sensor fault (wire break): INVALID",
      "data_type": "double",
      "metadata": {
        "display": { "limit_low": 0.0, "limit_high": 100.0, "description": "Tank T-101 level", "precision": 1, "units": "%" },
        "alarm": { "low_alarm_limit": 10.0, "low_warning_limit": 20.0, "high_warning_limit": 80.0, "high_alarm_limit": 90.0, "low_alarm_severity": "INVALID", "low_warning_severity": "MINOR", "high_warning_severity": "MINOR", "high_alarm_severity": "MAJOR", "hysteresis": 1 }
      }
    },
    "pump-mode": {
      "type": "select",
      "label": "Mode",
      "description": "Pump operating mode",
      "data_type": "enum",
      "options": ["Off", "Manual", "Auto", "Remote"]
    },
    "pump-start": {
      "type": "button",
      "label": "Start",
      "description": "Momentary command: writes 1 to the pump run command",
      "data_type": "bool",
      "color": "green",
      "write_value": 1
    },
    "pump-stop": {
      "type": "button",
      "label": "Stop",
      "description": "Momentary command: writes 0 to the pump run command",
      "data_type": "bool",
      "color": "red",
      "write_value": 0
    },
    "pump-run": {
      "type": "toggle_button",
      "label": "Run Command",
      "description": "Latching run command: reflects live state, sends the opposite value.",
      "data_type": "bool"
    },
    "pump-run-timeout": {
      "type": "toggle_button",
      "label": "Run Command",
      "description": "Latching run command: reflects live state, sends the opposite value. Resets to 0 (stopped) after 15 s",
      "data_type": "bool",
      "reset_timeout": 15000,
      "reset_default": 0
    },
    "pump-running": {
      "type": "led",
      "label": "Running",
      "description": "Pump run status",
      "data_type": "bool"
    },
    "discharge-valve": {
      "type": "multi_state_led",
      "label": "Discharge Valve XV-101",
      "description": "Interlocked with the pump run command: open when running",
      "data_type": "bool",
      "polygon_points": "0,0 0,18 15,9 30,18 30,0 15,9"
    }
  },
  "screens": [
    {
      "id": "epics",
      "title": "EPICS PVXS",
      "description": "Tank T-101 served by the embedded EPICS PVXS demo server",
      "actions": [
        { "type": "navigate", "label": "Modbus TCP >", "to": "modbus" },
        { "type": "navigate", "label": "ASCII TCP >", "to": "ascii_tcp" },
        { "type": "api", "label": "Start EPICS Sim", "method": "post", "path": "/api/server/start" },
        { "type": "api", "label": "Stop EPICS Sim", "method": "post", "path": "/api/server/stop" }
      ],
      "defaults": {
        "protocol": { "type": "epics-pvxs", "server": {} }
      },
      "widgets": [
        {
          "id": "epics_process", "type": "group", "label": "Process Monitoring", "level": 1,
          "description": "Live level sweeping through LOLO, LO, normal, HI and HIHI bands",
          "children": [
            { "id": "epics_level_readback", "preset": "level", "type": "text_update", "label": "Tank Level", "description": "PV demo:level — 40 s simulated sweep", "protocol": { "pv_name": "demo:level" } },
            { "id": "epics_level_gauge", "preset": "level", "type": "gauge", "label": "Tank Level", "orientation": "horizontal", "description": "PV demo:level — bar gauge with alarm zones", "protocol": { "pv_name": "demo:level" } },
            { "id": "epics_level_guage_vertical", "preset": "level", "type": "gauge", "label": "Tank Level", "orientation": "vertical", "description": "PV demo:level — vertical bar gauge with alarm zones", "protocol": { "pv_name": "demo:level" }, "style": { "width": "500px", "height": "400px" } }
          ]
        },
        {
          "id": "epics_alarms", "type": "group", "label": "Alarm States", "level": 1,
          "description": "Reference channels held in each alarm condition",
          "children": [
            { "id": "epics_alarm_normal", "preset": "level", "type": "text_update", "label": "Normal", "description": "PV demo:alarm:normal = 50 % — NO_ALARM", "protocol": { "pv_name": "demo:alarm:normal" } },
            { "id": "epics_alarm_minor", "preset": "level", "type": "text_update", "label": "Minor", "description": "PV demo:alarm:minor = 85 % — HI (MINOR)", "protocol": { "pv_name": "demo:alarm:minor" } },
            { "id": "epics_alarm_major", "preset": "level", "type": "text_update", "label": "Major", "description": "PV demo:alarm:major = 95 % — HIHI (MAJOR)", "protocol": { "pv_name": "demo:alarm:major" } },
            { "id": "epics_alarm_invalid", "preset": "sensor-fault", "protocol": { "pv_name": "demo:alarm:invalid" } },
            { "id": "epics_alarm_disconnected", "preset": "level", "type": "text_update", "label": "Disconnected", "description": "PV demo:offline is not served — no connection", "protocol": { "pv_name": "demo:offline", "server": null } }
          ]
        },
        {
          "id": "epics_setpoint", "type": "group", "label": "Setpoint Control", "level": 1,
          "description": "Two writers on one setpoint; drive it into the alarm bands",
          "children": [
            { "id": "epics_setpoint_entry", "preset": "level", "type": "text_entry", "label": "Level Setpoint", "description": "PV demo:setpoint — numeric entry", "protocol": { "pv_name": "demo:setpoint" } },
            { "id": "epics_setpoint_slider", "preset": "level", "type": "slider", "label": "Level Setpoint", "description": "PV demo:setpoint — slider", "protocol": { "pv_name": "demo:setpoint" } }
          ]
        },
        {
          "id": "epics_equipment", "type": "group", "label": "Commands & Feedback", "level": 1,
          "description": "Mode selection, commands and status",
          "children": [
            { "id": "epics_pump_mode", "preset": "pump-mode", "protocol": { "pv_name": "demo:pump:mode" } },
            { "id": "epics_pump_start", "preset": "pump-start", "protocol": { "pv_name": "demo:pump:run" } },
            { "id": "epics_pump_stop", "preset": "pump-stop", "protocol": { "pv_name": "demo:pump:run" } },
            { "id": "epics_pump_run", "preset": "pump-run", "protocol": { "pv_name": "demo:pump:run" } },
            { "id": "epics_pump_run_timeout", "preset": "pump-run-timeout", "protocol": { "pv_name": "demo:pump:run" } },
            { "id": "epics_pump_running", "preset": "pump-running", "protocol": { "pv_name": "demo:pump:run" } },
            { "id": "epics_discharge_valve", "preset": "discharge-valve", "protocol": { "pv_name": "demo:pump:run" } }
          ]
        },
        {
          "id": "epics_trends", "type": "group", "label": "Charts", "level": 1,
          "description": "EPICS array PVs: time series, histogram and scatter",
          "size": { "width": "1000px", "height": "1000px" },
          "children": [
            {
              "id": "epics_chart_temperature", "type": "chart", "label": "Temperature History",
              "data_type": "double_array", "chart_type": "line", "max_points": 100,
              "axis_label_x": "Sample", "axis_label_y": "Temperature (°C)",
              "description": "Single-series rolling line chart",
              "protocol": { "pv_name": "demo:temp:sensor", "server": { "metadata": { "display": { "limit_low": 15.0, "limit_high": 35.0, "description": "Ambient temperature sensor", "precision": 2, "units": "°C" } } } }
            },
            {
              "id": "epics_chart_multi", "type": "chart", "label": "Process Trends",
              "data_type": "double_array", "chart_type": "line", "max_points": 100,
              "axis_label_x": "Sample", "axis_label_y": "Value",
              "description": "Up to 6 PVs on one line chart",
              "protocol": { "pv_name": "demo:pressure:sensor", "pv_names": ["demo:flow:sensor", "demo:vibration:sensor"], "server": { "metadata": { "display": { "limit_low": 0.0, "limit_high": 100.0, "description": "Process pressure", "precision": 2, "units": "bar" } } } }
            },
            {
              "id": "epics_chart_histogram", "type": "chart", "label": "Signal Distribution",
              "data_type": "double_array", "chart_type": "histogram", "max_points": 200,
              "axis_label_x": "Amplitude", "axis_label_y": "Count",
              "description": "Histogram of noise signal distribution",
              "protocol": { "pv_name": "demo:noise:sensor", "server": { "metadata": { "display": { "limit_low": -5.0, "limit_high": 5.0, "description": "ADC noise signal", "precision": 3, "units": "V" } } } }
            },
            {
              "id": "epics_chart_scatter", "type": "chart", "label": "Beam Position",
              "data_type": "double_array", "chart_type": "scatter", "max_points": 80,
              "axis_label_x": "X Position (mm)", "axis_label_y": "Y Position (mm)",
              "description": "Scatter plot — interleaved [x0,y0, x1,y1, …] array",
              "protocol": { "pv_name": "demo:scatter:xy", "server": { "metadata": { "display": { "limit_low": -10.0, "limit_high": 10.0, "description": "2D beam position", "precision": 3, "units": "mm" } } } }
            }
          ]
        }
      ]
    },
    {
      "id": "modbus",
      "title": "Modbus TCP",
      "description": "Tank T-101 served by the Modbus TCP demo simulator on port 5020",
      "actions": [
        { "type": "navigate", "label": "< EPICS PVXS", "to": "epics" },
        { "type": "navigate", "label": "ASCII TCP >", "to": "ascii_tcp" },
        { "type": "api", "label": "Start Modbus Sim", "method": "post", "path": "/api/modbus/start" },
        { "type": "api", "label": "Stop Modbus Sim", "method": "post", "path": "/api/modbus/stop" }
      ],
      "defaults": {
        "protocol": { "type": "modbus-tcp", "host": "127.0.0.1", "port": 5020, "min_poll_interval_ms": 500 }
      },
      "widgets": [
        {
          "id": "modbus_process", "type": "group", "label": "Process Monitoring", "level": 1,
          "description": "Live level sweeping through LOLO, LO, normal, HI and HIHI bands",
          "children": [
            { "id": "modbus_level_readback", "preset": "level", "type": "text_update", "label": "Tank Level", "description": "Input register 2000 × 0.01 — simulated sweep", "protocol": { "register": 2000, "register_type": "input_register", "scale": 0.01 } },
            { "id": "modbus_level_gauge", "preset": "level", "type": "gauge", "label": "Tank Level", "orientation": "horizontal", "description": "Input register 2000 × 0.01 — bar gauge with alarm zones", "protocol": { "register": 2000, "register_type": "input_register", "scale": 0.01 } }
          ]
        },
        {
          "id": "modbus_alarms", "type": "group", "label": "Alarm States", "level": 1,
          "description": "Reference channels held in each alarm condition",
          "children": [
            { "id": "modbus_alarm_normal", "preset": "level", "type": "text_update", "label": "Normal", "description": "Unused holding register 3000 + offset 50 — NO_ALARM", "protocol": { "register": 3000, "register_type": "holding_register", "offset": 50.0 } },
            { "id": "modbus_alarm_minor", "preset": "level", "type": "text_update", "label": "Minor", "description": "Unused holding register 3001 + offset 85 — HI (MINOR)", "protocol": { "register": 3001, "register_type": "holding_register", "offset": 85.0 } },
            { "id": "modbus_alarm_major", "preset": "level", "type": "text_update", "label": "Major", "description": "Unused holding register 3002 + offset 95 — HIHI (MAJOR)", "protocol": { "register": 3002, "register_type": "holding_register", "offset": 95.0 } },
            { "id": "modbus_alarm_invalid", "preset": "sensor-fault", "protocol": { "register": 3003, "register_type": "holding_register", "offset": 5.0 } },
            { "id": "modbus_alarm_disconnected", "preset": "level", "type": "text_update", "label": "Disconnected", "description": "Port 5021 has no Modbus server — no connection", "protocol": { "port": 5021, "register": 3000, "register_type": "holding_register" } }
          ]
        },
        {
          "id": "modbus_setpoint", "type": "group", "label": "Setpoint Control", "level": 1,
          "description": "Two writers on one setpoint; drive it into the alarm bands",
          "children": [
            { "id": "modbus_setpoint_entry", "preset": "level", "type": "text_entry", "label": "Level Setpoint", "description": "Holding register 1002 × 0.1 — numeric entry", "protocol": { "register": 1002, "register_type": "holding_register", "scale": 0.1 } },
            { "id": "modbus_setpoint_slider", "preset": "level", "type": "slider", "label": "Level Setpoint", "description": "Holding register 1002 × 0.1 — slider", "protocol": { "register": 1002, "register_type": "holding_register", "scale": 0.1 } }
          ]
        },
        {
          "id": "modbus_equipment", "type": "group", "label": "Commands & Feedback", "level": 1,
          "description": "Mode selection, commands and status",
          "children": [
            { "id": "modbus_pump_mode", "preset": "pump-mode", "protocol": { "register": 1004, "register_type": "holding_register" } },
            { "id": "modbus_pump_start", "preset": "pump-start", "protocol": { "register": 1, "register_type": "coil" } },
            { "id": "modbus_pump_stop", "preset": "pump-stop", "protocol": { "register": 1, "register_type": "coil" } },
            { "id": "modbus_pump_run", "preset": "pump-run", "protocol": { "register": 1, "register_type": "coil" } },
            { "id": "modbus_pump_run_timeout", "preset": "pump-run-timeout", "protocol": { "register": 1, "register_type": "coil" } },
            { "id": "modbus_pump_running", "preset": "pump-running", "protocol": { "register": 1, "register_type": "coil" } },
            { "id": "modbus_discharge_valve", "preset": "discharge-valve", "protocol": { "register": 1, "register_type": "coil" } }
          ]
        },
        {
          "id": "modbus_features", "type": "group", "label": "Modbus Features", "level": 1,
          "description": "Simulator-driven coils, inverted logic and raw counters",
          "children": [
            { "id": "modbus_heartbeat", "type": "led", "label": "Heartbeat", "data_type": "bool", "description": "Coil 0 — toggles every 2 s", "protocol": { "register": 0, "register_type": "coil" } },
            { "id": "modbus_valve_inverted", "type": "multi_state_led", "label": "Valve B (inverted)", "data_type": "bool", "invert": true, "description": "Coil 2 — toggles every 3 s; 1 = CLOSED, 0 = OPEN", "protocol": { "register": 2, "register_type": "coil" } },
            { "id": "modbus_tick_counter", "type": "text_update", "label": "Tick Counter", "data_type": "int32", "description": "Holding register 1003 — wrapping counter, +1 every 500 ms", "protocol": { "register": 1003, "register_type": "holding_register" } }
          ]
        }
      ]
    },
    {
      "id": "ascii_tcp",
      "title": "ASCII TCP",
      "description": "Tank T-101 served by the ASCII line-protocol demo simulator on port 4000",
      "actions": [
        { "type": "navigate", "label": "< EPICS PVXS", "to": "epics" },
        { "type": "navigate", "label": "< Modbus TCP", "to": "modbus" },
        { "type": "api", "label": "Start ASCII TCP Sim", "method": "post", "path": "/api/ascii-tcp/start" },
        { "type": "api", "label": "Stop ASCII TCP Sim", "method": "post", "path": "/api/ascii-tcp/stop" }
      ],
      "defaults": {
        "protocol": { "type": "ascii-tcp", "host": "127.0.0.1", "port": 4000, "line_ending": "crlf", "response_mode": "number", "min_poll_interval_ms": 500 }
      },
      "widgets": [
        {
          "id": "ascii_process", "type": "group", "label": "Process Monitoring", "level": 1,
          "description": "Live level sweeping through LOLO, LO, normal, HI and HIHI bands",
          "children": [
            { "id": "ascii_level_readback", "preset": "level", "type": "text_update", "label": "Tank Level", "description": "READ TEMPERATURE (25 ± 7) rescaled to 5–95 %", "protocol": { "read_command": "READ TEMPERATURE", "read_response": "TEMPERATURE=%f", "scale": 6.428571, "offset": -110.714286 } },
            { "id": "ascii_level_gauge", "preset": "level", "type": "gauge", "label": "Tank Level", "orientation": "horizontal", "description": "READ TEMPERATURE rescaled — bar gauge with alarm zones", "protocol": { "read_command": "READ TEMPERATURE", "read_response": "TEMPERATURE=%f", "scale": 6.428571, "offset": -110.714286 } }
          ]
        },
        {
          "id": "ascii_alarms", "type": "group", "label": "Alarm States", "level": 1,
          "description": "Reference channels held in each alarm condition",
          "children": [
            { "id": "ascii_alarm_normal", "preset": "level", "type": "text_update", "label": "Normal", "description": "READ REFERENCE (0) + offset 50 — NO_ALARM", "protocol": { "read_command": "READ REFERENCE", "read_response": "REFERENCE=%f", "offset": 50.0 } },
            { "id": "ascii_alarm_minor", "preset": "level", "type": "text_update", "label": "Minor", "description": "READ REFERENCE (0) + offset 85 — HI (MINOR)", "protocol": { "read_command": "READ REFERENCE", "read_response": "REFERENCE=%f", "offset": 85.0 } },
            { "id": "ascii_alarm_major", "preset": "level", "type": "text_update", "label": "Major", "description": "READ REFERENCE (0) + offset 95 — HIHI (MAJOR)", "protocol": { "read_command": "READ REFERENCE", "read_response": "REFERENCE=%f", "offset": 95.0 } },
            { "id": "ascii_alarm_invalid", "preset": "sensor-fault", "protocol": { "read_command": "READ REFERENCE", "read_response": "REFERENCE=%f", "offset": 5.0 } },
            { "id": "ascii_alarm_disconnected", "preset": "level", "type": "text_update", "label": "Disconnected", "description": "Port 4001 has no ASCII server — no connection", "protocol": { "port": 4001, "read_command": "READ REFERENCE", "read_response": "REFERENCE=%f" } }
          ]
        },
        {
          "id": "ascii_setpoint", "type": "group", "label": "Setpoint Control", "level": 1,
          "description": "Two writers on one setpoint; drive it into the alarm bands",
          "children": [
            { "id": "ascii_setpoint_entry", "preset": "level", "type": "text_entry", "label": "Level Setpoint", "description": "READ SETPOINT / SET SETPOINT {value} — numeric entry", "protocol": { "read_command": "READ SETPOINT", "read_response": "SETPOINT=%f", "write_command": "SET SETPOINT {value}" } },
            { "id": "ascii_setpoint_slider", "preset": "level", "type": "slider", "label": "Level Setpoint", "description": "READ SETPOINT / SET SETPOINT {value} — slider", "protocol": { "read_command": "READ SETPOINT", "read_response": "SETPOINT=%f", "write_command": "SET SETPOINT {value}" } }
          ]
        },
        {
          "id": "ascii_equipment", "type": "group", "label": "Commands & Feedback", "level": 1,
          "description": "Mode selection, commands and status",
          "children": [
            { "id": "ascii_pump_mode", "preset": "pump-mode", "protocol": { "read_command": "READ MODE", "read_response": "MODE=%f", "write_command": "SET MODE {value}" } },
            { "id": "ascii_pump_start", "preset": "pump-start", "protocol": { "read_command": "READ ENABLED", "read_response": "ENABLED=%s", "write_command": "SET ENABLED {value}", "response_mode": "bool" } },
            { "id": "ascii_pump_stop", "preset": "pump-stop", "protocol": { "read_command": "READ ENABLED", "read_response": "ENABLED=%s", "write_command": "SET ENABLED {value}", "response_mode": "bool" } },
            { "id": "ascii_pump_run", "preset": "pump-run", "protocol": { "read_command": "READ ENABLED", "read_response": "ENABLED=%s", "write_command": "SET ENABLED {value}", "response_mode": "bool" } },
            { "id": "ascii_pump_run_timeout", "preset": "pump-run-timeout", "protocol": { "read_command": "READ ENABLED", "read_response": "ENABLED=%s", "write_command": "SET ENABLED {value}", "response_mode": "bool" } },
            { "id": "ascii_pump_running", "preset": "pump-running", "protocol": { "read_command": "READ ENABLED", "read_response": "ENABLED=%s", "response_mode": "bool" } },
            { "id": "ascii_discharge_valve", "preset": "discharge-valve", "protocol": { "read_command": "READ ENABLED", "read_response": "ENABLED=%s", "response_mode": "bool" } }
          ]
        },
        {
          "id": "ascii_features", "type": "group", "label": "ASCII Features", "level": 1,
          "description": "Raw text responses",
          "children": [
            { "id": "ascii_server_message", "type": "text_update", "label": "Server Message", "data_type": "string", "description": "READ MESSAGE — raw text response", "protocol": { "read_command": "READ MESSAGE", "read_response": "MESSAGE=%s", "response_mode": "text", "min_poll_interval_ms": 1000 } }
          ]
        }
      ]
    }
  ]
}
